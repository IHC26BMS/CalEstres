<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/calendarioRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F8FA"
    android:orientation="vertical"
    tools:context=".Calendario">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="3dp"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CAL·ESTRÉS"
            android:textColor="#63808A"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="5dp">

            <Spinner
                android:id="@+id/monthSpinner"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.4"
                android:backgroundTint="#29AFC0"
                android:spinnerMode="dropdown" />

            <Spinner
                android:id="@+id/yearSpinner"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:backgroundTint="#29AFC0"
                android:spinnerMode="dropdown" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingBottom="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tu calendario"
                    android:textColor="#173B46"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/calendarLegend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● Estrés bajo   ● medio   ● alto"
                    android:textColor="#68818A"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/calendarCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/calendar_card_background"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:id="@+id/weekdaysRow"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:orientation="horizontal" />

                <LinearLayout
                    android:id="@+id/calendarGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <TextView
                android:id="@+id/calendarHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingTop="9dp"
                android:paddingBottom="14dp"
                android:text="Selecciona un día para consultar o registrar cómo te sentiste."
                android:textColor="#71858C"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/entryCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/calendar_card_background"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/selectedDateTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#173B46"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            tools:text="Miércoles, 14 de noviembre" />

                        <TextView
                            android:id="@+id/selectedDateSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingTop="3dp"
                            android:textColor="#71858C"
                            android:textSize="12sp"
                            tools:text="Resumen de tu día" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/editButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="4dp"
                        android:text="Editar"
                        android:textColor="#168B9D"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/infoPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="14dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="#F3F8F9"
                            android:orientation="vertical"
                            android:padding="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ESTRÉS" android:textColor="#71858C" android:textSize="10sp" android:textStyle="bold" />
                            <TextView android:id="@+id/stressValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingTop="5dp" android:textColor="#173B46" android:textSize="16sp" android:textStyle="bold" tools:text="6 / 10" />
                            <TextView android:id="@+id/stressEvaluation" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingTop="2dp" android:textSize="11sp" tools:text="Moderado" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:background="#F3F8F9"
                            android:orientation="vertical"
                            android:padding="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SUEÑO" android:textColor="#71858C" android:textSize="10sp" android:textStyle="bold" />
                            <TextView android:id="@+id/sleepValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingTop="5dp" android:textColor="#173B46" android:textSize="16sp" android:textStyle="bold" tools:text="7.5 horas" />
                            <TextView android:id="@+id/sleepEvaluation" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingTop="2dp" android:textSize="11sp" tools:text="Suficiente" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:background="#F3F8F9"
                            android:orientation="vertical"
                            android:padding="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="COMIDAS" android:textColor="#71858C" android:textSize="10sp" android:textStyle="bold" />
                            <TextView android:id="@+id/mealsValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingTop="5dp" android:textColor="#173B46" android:textSize="16sp" android:textStyle="bold" tools:text="3 comidas" />
                            <TextView android:id="@+id/mealsEvaluation" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingTop="2dp" android:textSize="11sp" tools:text="Equilibrado" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="16dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="NOTAS DEL DÍA"
                            android:textColor="#71858C"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/infoSentimentTag"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:background="@drawable/counter_button_background"
                            android:gravity="center"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:text="Neutral"
                            android:textColor="#168B9D"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/notesEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/notes_background"
                        android:gravity="top|start"
                        android:hint="¿Qué quieres recordar de este día?"
                        android:inputType="textCapSentences|textMultiLine"
                        android:minHeight="82dp"
                        android:padding="12dp"
                        android:textColor="#24444D"
                        android:textColorHint="#9AAEB4"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/saveNotesButton"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_gravity="end"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="4dp"
                        android:text="Guardar nota"
                        android:textColor="#168B9D"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/logPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="14dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Nivel de estrés" android:textColor="#35545D" android:textSize="14sp" android:textStyle="bold" />
                        <TextView android:id="@+id/stressSeekValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5 / 10" android:textColor="#168B9D" android:textStyle="bold" />
                    </LinearLayout>
                    <SeekBar
                        android:id="@+id/stressSeekBar"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:max="9"
                        android:progress="4"
                        android:progressTint="#F4B942"
                        android:thumbTint="#F4B942"
                        android:progressBackgroundTint="#DDE8EB" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Horas de sueño" android:textColor="#35545D" android:textSize="14sp" android:textStyle="bold" />
                        <TextView android:id="@+id/sleepSeekValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="7.0 horas" android:textColor="#168B9D" android:textStyle="bold" />
                    </LinearLayout>
                    <SeekBar
                        android:id="@+id/sleepSeekBar"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:max="120"
                        android:progress="70"
                        android:progressTint="#45B879"
                        android:thumbTint="#45B879"
                        android:progressBackgroundTint="#DDE8EB" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Número de comidas" android:textColor="#35545D" android:textSize="14sp" android:textStyle="bold" />
                        <TextView android:id="@+id/minusMeals" android:layout_width="42dp" android:layout_height="42dp" android:background="@drawable/counter_button_background" android:clickable="true" android:focusable="true" android:gravity="center" android:text="−" android:textColor="#168B9D" android:textSize="24sp" />
                        <TextView android:id="@+id/mealCount" android:layout_width="48dp" android:layout_height="wrap_content" android:gravity="center" android:text="3" android:textColor="#173B46" android:textSize="17sp" android:textStyle="bold" />
                        <TextView android:id="@+id/plusMeals" android:layout_width="42dp" android:layout_height="42dp" android:background="@drawable/counter_button_background" android:clickable="true" android:focusable="true" android:gravity="center" android:text="+" android:textColor="#168B9D" android:textSize="22sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="6dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="NOTAS DEL DÍA"
                            android:textColor="#71858C"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/logSentimentTag"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:background="@drawable/counter_button_background"
                            android:gravity="center"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:text="Neutral"
                            android:textColor="#168B9D"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                    <EditText
                        android:id="@+id/logNotesEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/notes_background"
                        android:gravity="top|start"
                        android:hint="¿Qué quieres recordar de este día?"
                        android:inputType="textCapSentences|textMultiLine"
                        android:minHeight="72dp"
                        android:padding="12dp"
                        android:textColor="#24444D"
                        android:textColorHint="#9AAEB4"
                        android:textSize="14sp" />

                    <ImageButton
                        android:id="@+id/saveEntryButton"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_gravity="end"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/save_button_background"
                        android:contentDescription="Guardar registro del día"
                        android:src="@android:drawable/ic_menu_save"
                        android:tint="#FFFFFF" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/noteSearchCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/calendar_card_background"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Explorar tus notas"
                    android:textColor="#173B46"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="3dp"
                    android:text="Busca una palabra y consulta el estrés medio de esos días."
                    android:textColor="#71858C"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="12dp">

                    <EditText
                        android:id="@+id/noteSearchInput"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@drawable/notes_background"
                        android:hint="Palabra (ej. trabajo)"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:singleLine="true"
                        android:textColor="#24444D"
                        android:textColorHint="#9AAEB4"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/noteSearchButton"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/save_button_background"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="Buscar"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/noteSearchResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="12dp"
                    android:textColor="#35545D"
                    android:textSize="14sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
